<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Creature</RootNamespace>
    <AssemblyName>DesktopPets</AssemblyName>
    <Product>Desktop Pets</Product>
    <AssemblyTitle>Desktop Pets</AssemblyTitle>
    <Company>Kunal Jangid</Company>
    <Authors>Kunal Jangid</Authors>
    <Description>Desktop Pets - Interactive pixel-art desktop companions for Windows</Description>
    <Copyright>Copyright © 2026 Kunal Jangid. All rights reserved.</Copyright>
    <DefaultItemExcludes>$(DefaultItemExcludes);Creature.Tests\**;docs\**</DefaultItemExcludes>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\**\*.*" Exclude="Assets\*.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyAssetsToOutput" AfterTargets="Build;Publish">
    <ItemGroup>
      <_AssetFiles Include="Assets\**\*.*" Exclude="Assets\*.gif" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssetFiles)" DestinationFiles="@(_AssetFiles->'$(TargetDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AssetFiles)" DestinationFiles="@(_AssetFiles->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" Condition="'$(PublishDir)' != ''" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Creature.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
